# Local development only. Do not commit a populated .env file.
NODE06_ENVIRONMENT=development
NODE06_HOST=127.0.0.1
NODE06_PORT=8086
# Exact HTTPS origin for first-party account operations (no trailing slash).
# NODE06_MANAGEMENT_ORIGIN=https://wiki.example.org
# NODE06_SESSION_HOURS=24
# NODE06_REGISTRATION_PER_HOUR=3
# NODE06_LOGIN_PER_MINUTE=10
# NODE06_ACCOUNT_LOGIN_PER_MINUTE=10
# NODE06_SITE_CREATIONS_PER_HOUR=5
# NODE06_SITE_RENEWALS_PER_HOUR=5
# NODE06_SITE_VERIFICATIONS_PER_MINUTE=6
# NODE06_CLAIM_MAX_ATTEMPTS=10
# NODE06_VERIFIER_SECONDS=10
# NODE06_VERIFIER_SLOTS=2
# NODE06_HOSTED_DIST=/absolute/path/to/node06/dist
# NODE06_HOSTED_TITLE=Geno-Dice Wiki
# NODE06_EMBED_ORIGIN=https://embed.example.org
# NODE06_DEFAULT_SITE_ID=s_<active-site-id>
# NODE06_HOSTED_SITE_LIMIT=200
# NODE06_DATABASE_URL=postgresql+psycopg://node06:replace-me@127.0.0.1:5432/node06
